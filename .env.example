ENVIRONMENT=dev

# ---------------------------------------------------------------------------
# Provedor de IA ativo: "gemini" ou "openai"
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

# --- Configuração do Gemini (usada quando AI_PROVIDER=gemini) --------------
# Obtenha sua chave em: https://aistudio.google.com/app/api-keys
AI_API_KEY=
# Confira o nome de modelo atual antes de fixar - nomes são descontinuados
# com frequência: https://ai.google.dev/gemini-api/docs/changelog?hl=pt-br
AI_MODEL_NAME=gemini-3.5-flash # ou outro modelo

# --- Configuração da OpenAI (usada quando AI_PROVIDER=openai) --------------
# Obtenha sua chave em: https://platform.openai.com/api-keys
# ATENÇÃO: diferente do Gemini, a OpenAI cobra por uso (pré-pago) - configure
# um limite de gasto em https://platform.openai.com/settings/organization/limits
# antes de rodar testes em lote.
OPENAI_API_KEY="sua_chave_aqui"
OPENAI_MODEL_NAME=gpt-4o-mini

# ---------------------------------------------------------------------------
# Integração com o ecossistema IF4Health
# ---------------------------------------------------------------------------
IF_API=https://if4health.charqueadas.ifsul.edu.br/biofass